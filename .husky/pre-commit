if ! command -v gitleaks >/dev/null 2>&1; then
	echo "gitleaks is not installed, so the secret scan cannot run. Install it with 'brew install gitleaks' or from https://github.com/gitleaks/gitleaks#installing." >&2
	exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --verbose .
pnpm lint-staged
